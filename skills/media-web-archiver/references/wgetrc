# ==========================================
# GNU Wget Optimizasyon Konfigurasyonu
# Konum: ~/.wgetrc
# ==========================================

# --- Indirme ve Devam Ettirme ---
# Kesilen indirmeleri otomatik olarak devam ettir
continue = on

# Sunucudaki dosya daha yeniyse indir, ayni ise tekrar indirme
timestamping = on

# Baglanti koptugunda veya hata alindiginda yeniden deneme sayisi
tries = 10
retry_connrefused = on
waitretry = 2

# --- Zaman Asimlari (Timeout) ---
# Genel zaman asimi ve alt asim sureleri (saniye)
timeout = 30
dns_timeout = 10
connect_timeout = 15
read_timeout = 30

# --- Ag & Protokol Optimizasyonu ---
# Kalici HTTP baglantilarini kullan
keep_alive = on

# Pasif FTP modunu aktif et (firewall/NAT uyumlulugu)
passive_ftp = on

# DNS/Baglanti gecikmelerini azaltmak icin IPv4 onceliklendir
prefer_family = IPv4

# --- Uyumluluk & Engel Asma ---
# Wget engelleyen siteler icin modern standart bir tarayici User-Agent'i
user_agent = Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36

# robots.txt engellerine takilmadan indirme yap
robots = off

# SSL/TLS sertifika kontrolu acik kalsin (guvenlik icin)
check_certificate = on

# --- Gorunum & Cikti ---
# Net ve okunabilir ilerleme cubugu
progress = bar:force
